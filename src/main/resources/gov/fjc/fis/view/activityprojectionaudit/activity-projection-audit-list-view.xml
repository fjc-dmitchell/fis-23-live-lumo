<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://activityProjectionAuditListView.title"
      focusComponent="activityProjectionAuditsDataGrid">
    <data>
        <collection id="activityProjectionAuditsDc"
                    class="gov.fjc.fis.entity.ActivityProjectionAudit">
            <loader id="activityProjectionAuditsDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <settings auto="true"/>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <fragment id="searchFragment" class="gov.fjc.fis.view.search.CustomSearchFragment">
            <properties>
                <property name="hostDataContainer" value="activityProjectionAuditsDc" type="CONTAINER_REF"/>
            </properties>
        </fragment>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="excelExportButton" action="activityProjectionAuditsDataGrid.excelExportAction"/>
            <button id="readButton" action="activityProjectionAuditsDataGrid.readAction"/>
            <gridColumnVisibility dataGrid="activityProjectionAuditsDataGrid" icon="COG"/>
            <simplePagination id="pagination" dataLoader="activityProjectionAuditsDl" autoLoad="true"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"
                              itemsPerPageDefaultValue="250"/>
        </hbox>
        <dataGrid id="activityProjectionAuditsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="activityProjectionAuditsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes">
            <actions>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="readAction" type="list_read"/>
            </actions>
            <columns resizable="true">
                <column property="activity.fund.fundCode" width="90px" visible="false" header="fund" flexGrow="0"/>
                <column property="activity.division.appropriation.budgetFiscalYear" width="70px" header="BFY"
                        flexGrow="0"/>
                <column property="activity.division.divisionCode" header="Division" width="90px" textAlign="CENTER"
                        flexGrow="0"/>
                <column property="activity.activityNumber" header="Activity" width="90px" flexGrow="0"/>
                <column property="activity.title" width="350px" flexGrow="1"/>
                <column property="activity.group.groupCode" visible="false" header="Group" textAlign="CENTER"
                        width="90px" flexGrow="0"/>
                <column property="activity.branch.branchCode" visible="false" header="Branch" textAlign="CENTER"
                        width="90px" flexGrow="0"/>
                <column property="objectClass.budgetObjectClass" header="BOC" width="75px" flexGrow="0"/>
                <column property="oldAmount" textAlign="END" width="140px" header="Old Projection" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="newAmount" textAlign="END" width="140px" header="New Projection" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="changeType" width="130px" flexGrow="0"/>
                <column property="auditDate" width="180px" flexGrow="0">
                    <localDateTimeRenderer format="MM-dd-yyyy HH:mm:ss"/>
                </column>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
