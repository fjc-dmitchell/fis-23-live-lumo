<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://departmentListView.title"
      focusComponent="departmentsDataGrid">
    <data>
        <collection id="departmentsDc"
                    class="gov.fjc.fis.entity.personnel.Department">
            <fetchPlan extends="_base"/>
            <loader id="departmentsDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_Department e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <settings auto="true"/>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="departmentsDataGrid.createAction"/>
            <button id="editButton" action="departmentsDataGrid.editAction"/>
            <button id="excelExportButton" action="departmentsDataGrid.excelExportAction"/>
            <button id="removeButton" action="departmentsDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="departmentsDl"/>
        </hbox>
        <dataGrid id="departmentsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="departmentsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="deptid" width="130px" flexGrow="0"/>
                <column property="effdt" flexGrow="0" width="120px" textAlign="END"/>
                <column property="effStatus" flexGrow="0" width="100px" textAlign="CENTER"/>
                <column property="descr" width="300px" flexGrow="0"/>
                <column property="descrshort" width="170px" flexGrow="0"/>
                <column property="jlCostOrgCd" width="130px" flexGrow="0"/>
                <column property="jlBudCatgCd"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
