<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://activityReimbursementListView.title"
      focusComponent="activityReimbursementsDataGrid">
    <data>
        <collection id="activityReimbursementsDc"
                    class="gov.fjc.fis.entity.ActivityReimbursement">
            <fetchPlan extends="_base">
                <property name="activity" fetchPlan="_instance_name">
                    <property name="title"/>
                    <property name="titleAndCode"/>
                </property>
                <property name="createdByString"/>
            </fetchPlan>
            <loader id="activityReimbursementsDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_ActivityReimbursement e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <settings auto="true"/>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <fragment id="searchFragment" class="gov.fjc.fis.view.search.CustomSearchFragment">
            <properties>
                <property name="hostDataContainer" value="activityReimbursementsDc" type="CONTAINER_REF"/>
            </properties>
        </fragment>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="excelExportButton" action="activityReimbursementsDataGrid.excelExportAction"/>
            <button id="readButton" action="activityReimbursementsDataGrid.readAction"/>
            <gridColumnVisibility dataGrid="activityReimbursementsDataGrid" icon="COG"/>
            <simplePagination id="pagination" dataLoader="activityReimbursementsDl" autoLoad="true"
                              itemsPerPageDefaultValue="250"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"/>
        </hbox>
        <dataGrid id="activityReimbursementsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="activityReimbursementsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes">
            <actions>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="readAction" type="list_read"/>
            </actions>
            <columns resizable="true">
                <column property="activity.fund.fundCode" header="Fund" width="85px" flexGrow="0" visible="false"/>
                <column property="activity.division.appropriation.budgetFiscalYear" header="BFY" width="70px"
                        flexGrow="0"/>
                <column property="activity.division.divisionCode" header="Division" textAlign="CENTER" width="90px"
                        flexGrow="0"/>
                <column property="activity.titleAndCode" header="Activity" width="350px" flexGrow="1"/>
                <column property="activity.group.titleAndCode" header="Group" width="350px" visible="false"/>
                <column property="activity.branch.titleAndCode" header="Branch" width="350px" visible="false"/>
                <column property="objectClass.budgetObjectClass" header="BOC" width="75px" visible="true" flexGrow="0"/>
                <column property="objectClass.titleAndCode" header="Object Class" width="350px" visible="false"/>
                <column property="source" width="300px" flexGrow="0"/>
                <column property="amount" header="Reimbursement" textAlign="END" width="140px" flexGrow="0"/>
                <column property="documentNumber" width="250px"/>
                <column property="documentDate" width="250px"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>