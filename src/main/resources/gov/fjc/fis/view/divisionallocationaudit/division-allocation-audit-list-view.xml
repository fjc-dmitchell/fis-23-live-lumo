<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://divisionAllocationAuditListView.title"
      focusComponent="divisionAllocationAuditsDataGrid">
    <data>
        <collection id="divisionAllocationAuditsDc"
                    class="gov.fjc.fis.entity.DivisionAllocationAudit">
            <fetchPlan extends="_base">
                <property name="division" fetchPlan="_base"/>
                <property name="objectCategory" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="divisionAllocationAuditsDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_DivisionAllocationAudit e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <settings auto="true"/>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <header text="This view will include a division search and show the audit trail of all allocation changes. Requested by Nanticha 8/26/25"/>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="excelExportButton" action="divisionAllocationAuditsDataGrid.excelExportAction"/>
            <button id="readButton" action="divisionAllocationAuditsDataGrid.readAction"/>
            <gridColumnVisibility dataGrid="divisionAllocationAuditsDataGrid" icon="COG"/>
            <simplePagination id="pagination" dataLoader="divisionAllocationAuditsDl" autoLoad="true"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"
                              itemsPerPageDefaultValue="250"/>
        </hbox>
        <dataGrid id="divisionAllocationAuditsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="divisionAllocationAuditsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes">
            <actions>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="readAction" type="list_read"/>
            </actions>
            <columns resizable="true">
                <column property="division.appropriation.budgetFiscalYear" header="BFY" width="70px" flexGrow="0"/>
                <column property="division.titleAndCode" header="Division"/>
                <column property="objectCategory.titleAndCode" header="BOC"/>
                <column property="auditDate" flexGrow="0" width="150px"/>
                <column property="oldOneYearAmount" textAlign="END" header="Old Amount" width="120px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="newOneYearAmount" textAlign="END" header="New Amount" width="120px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="oldTwoYearAmount" textAlign="END" header="Old Amount" width="120px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="newTwoYearAmount" textAlign="END" header="New Amount" width="120px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="changeType" width="70px" flexGrow="0" header="Type"/>
                <column property="updatedAttributes"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
