<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://divisionAllocationAuditListView.title"
      focusComponent="divisionAllocationAuditsDataGrid">
    <data>
        <collection id="divisionAllocationAuditsDc"
                    class="gov.fjc.fis.entity.DivisionAllocationAudit">
            <loader id="divisionAllocationAuditsDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <settings auto="true"/>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <fragment id="searchFragment" class="gov.fjc.fis.view.search.CustomSearchFragment">
            <properties>
                <property name="hostDataContainer" value="divisionAllocationAuditsDc" type="CONTAINER_REF"/>
            </properties>
        </fragment>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="excelExportButton" action="divisionAllocationAuditsDataGrid.excelExportAction"/>
            <button id="readButton" action="divisionAllocationAuditsDataGrid.readAction"/>
            <gridColumnVisibility dataGrid="divisionAllocationAuditsDataGrid" icon="COG"/>
            <simplePagination id="pagination" dataLoader="divisionAllocationAuditsDl" autoLoad="true"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"
                              itemsPerPageDefaultValue="250"/>
        </hbox>
        <dataGrid id="divisionAllocationAuditsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="divisionAllocationAuditsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes">
            <actions>
                <action id="excelExportAction" type="grdexp_excelExport"/>
                <action id="readAction" type="list_read"/>
            </actions>
            <columns resizable="true">
                <column property="division.appropriation.budgetFiscalYear" header="BFY" width="70px" flexGrow="0"/>
                <column property="division.divisionCode" header="Division" width="90px" textAlign="CENTER"
                        flexGrow="0"/>
                <column property="objectCategory.majorObjectClass" header="BOC" width="75px" flexGrow="0"
                        textAlign="CENTER"/>
                <column property="auditDate" flexGrow="0" width="160px" textAlign="CENTER"/>
                <column property="oldOneYearAmount" textAlign="END" header="Old Amount" width="125px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="newOneYearAmount" textAlign="END" header="New Amount" width="125px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="oldTwoYearAmount" textAlign="END" header="Old Amount" width="125px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="newTwoYearAmount" textAlign="END" header="New Amount" width="125px" flexGrow="0">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
                <column property="changeType" width="85px" flexGrow="0" header="Type" textAlign="CENTER"/>
                <column property="updatedAttributes" flexGrow="1" width="300px"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
