<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://jitfTransferListView.title"
      focusComponent="jitfTransfersDataGrid">
    <data>
        <collection id="jitfTransfersDc"
                    class="gov.fjc.fis.entity.JitfTransfer">
            <fetchPlan extends="_base">
                <property name="createdByString"/>
            </fetchPlan>
            <loader id="jitfTransfersDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_JitfTransfer e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createBtn" action="jitfTransfersDataGrid.create"/>
            <button id="editBtn" action="jitfTransfersDataGrid.edit"/>
            <button id="excelExportBtn" action="jitfTransfersDataGrid.excelExport"/>
            <button id="removeBtn" action="jitfTransfersDataGrid.remove"/>
            <simplePagination id="pagination" dataLoader="jitfTransfersDl"/>
        </hbox>
        <dataGrid id="jitfTransfersDataGrid"
                  width="440px"
                  minHeight="20em"
                  dataContainer="jitfTransfersDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="excelExport" type="grdexp_excelExport"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns resizable="true">
<!--                <column property="objectClass.category.appropriation.budgetFiscalYear" width="70px" header="BFY"/>-->
                <column property="objectClass.budgetObjectClass" width="90px" header="BOC"/>
                <column property="transferDate" width="140px" header="Transfer Date" textAlign="END"/>
                <column property="amount" width="140px" textAlign="END">
                    <numberRenderer numberFormat="#,##0"/>
                </column>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
