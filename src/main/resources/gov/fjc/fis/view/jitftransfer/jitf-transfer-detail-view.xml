<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://jitfTransferDetailView.title"
      focusComponent="form">
    <data>
        <instance id="jitfTransferDc"
                  class="gov.fjc.fis.entity.JitfTransfer">
            <fetchPlan extends="_base">
                <property name="createdByString"/>
            </fetchPlan>
            <loader id="jitfTransferDl"/>
        </instance>
        <collection id="categoriesDc" class="gov.fjc.fis.entity.ObjectCategory">
            <loader id="categoriesDl" readOnly="true"/>
        </collection>
        <collection id="objectClassesDc" class="gov.fjc.fis.entity.ObjectClass">
            <loader id="objectClassesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto" maxWidth="1000px">
            <div classNames="grid-panel">
                <vbox classNames="contrast-panel">
                    <textField id="budgetFiscalYearField"
                               label="Budget Fiscal Year" datatype="string" readOnly="true"/>
                    <formLayout id="form" dataContainer="jitfTransferDc">
                        <entityComboBox id="categoryField" itemsContainer="categoriesDc"
                                        metaClass="fis_ObjectCategory" label="Category (MOC)"/>
                        <entityComboBox id="budgetObjectClassField" itemsContainer="objectClassesDc"
                                        property="objectClass" label="Object Class (BOC)"/>
                        <datePicker id="transferDateField" property="transferDate"/>
                        <textField id="amountField" property="amount"/>
                        <textArea id="memoField" property="memo" minHeight="5em" colspan="2"/>
                    </formLayout>
                </vbox>
            </div>
        </vbox>
        <vbox>
            <p id="createdByString"/>
        </vbox>
        <hbox id="detailActions" classNames="px-m py-s bg-contrast-5">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>