    <layout expand="contentBox">
        <vbox id="contentBox" css="overflow: auto" padding="false" maxWidth="1000px">
        <vbox id="formWrapper" classNames="contrast-panel">

                    <textField id="budgetFiscalYearField"
                               label="Budget Fiscal Year" datatype="string" readOnly="true"/>
                    <formLayout id="form" dataContainer="jitfTransferDc">
                        <entityComboBox id="categoryField" itemsContainer="categoriesDc"
                                        metaClass="fis_ObjectCategory" label="Object Category (MOC)" required="true"/>
                        <entityComboBox id="budgetObjectClassField" itemsContainer="objectClassesDc"
                                        property="objectClass" label="Object Class (BOC)"/>
                        <datePicker id="transferDateField" property="transferDate"/>
                        <textField id="amountField" property="amount"/>
                        <textArea id="memoField" property="memo" minHeight="5em" colspan="2"/>
                    </formLayout>
                </vbox>
        </vbox>
            <p id="createdByString"/>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>