<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://fileAttachmentCategoryListView.title"
      focusComponent="fileAttachmentCategoriesDataGrid">
    <data>
        <collection id="fileAttachmentCategoriesDc"
                    class="gov.fjc.fis.entity.FileAttachmentCategory">
            <fetchPlan extends="_base"/>
            <loader id="fileAttachmentCategoriesDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_FileAttachmentCategory e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createButton" action="fileAttachmentCategoriesDataGrid.createAction"/>
            <button id="editButton" action="fileAttachmentCategoriesDataGrid.editAction"/>
            <button id="removeButton" action="fileAttachmentCategoriesDataGrid.removeAction"/>
            <simplePagination id="pagination" dataLoader="fileAttachmentCategoriesDl"/>
        </hbox>
        <dataGrid id="fileAttachmentCategoriesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="fileAttachmentCategoriesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="title" flexGrow="0" width="370px"/>
                <column property="active" flexGrow="1"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
