<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://userSettingsItemListView.title"
      focusComponent="userSettingsItemsDataGrid">
    <data>
        <collection id="userSettingsItemsDc"
                    class="io.jmix.flowuidata.entity.UserSettingsItem">
            <fetchPlan extends="_base"/>
            <loader id="userSettingsItemsDl" readOnly="true">
                <query>
                    <![CDATA[select e from flowui_UserSettingsItem e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="readButton" action="userSettingsItemsDataGrid.read"/>
            <button id="removeButton" icon="vaadin:trash" text="Remove" enabled="false"/>
            <simplePagination id="pagination" dataLoader="userSettingsItemsDl"/>
        </hbox>
        <dataGrid id="userSettingsItemsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="userSettingsItemsDc" selectionMode="MULTI">
            <actions>
                <action id="read" type="list_read"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns>
                <column property="username" width="10em"/>
                <column property="key" width="15em"/>
                <column property="value" width="100%"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
