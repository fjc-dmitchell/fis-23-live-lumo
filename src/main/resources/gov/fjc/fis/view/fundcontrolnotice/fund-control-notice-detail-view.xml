<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://fundControlNoticeDetailView.title">
    <data>
        <instance id="fundControlNoticeDc"
                  class="gov.fjc.fis.entity.FundControlNotice">
            <fetchPlan extends="_base">
                <property name="obligation" fetchPlan="_base">
                    <property name="activity" fetchPlan="_base">
                        <property name="titleAndCode"/>
                        <property name="fund" fetchPlan="_base">
                            <property name="titleAndCode"/>
                        </property>
                        <property name="division" fetchPlan="_base">
                            <property name="titleAndCode"/>
                        </property>
                    </property>
                    <property name="objectClass" fetchPlan="_base">
                        <property name="titleAndCode"/>
                    </property>
                </property>
                <property name="aoSyncString"/>
                <property name="createdByString"/>
                <property name="attachments" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="fundControlNoticeDl"/>
            <collection id="attachmentsDc" property="attachments"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false" spacing="false"
            expand="contentBox">
        <vbox id="contentBox" classNames="overflow-auto">
            <div classNames="grid-panel">

                <vbox classNames="contrast-panel">
                    <details opened="true" summaryText="FCN" minWidth="100%">
                        <formLayout id="obligationLookupForm" dataContainer="fundControlNoticeDc">

                            <entityComboBox id="docIdSuggestionField" dataContainer="fundControlNoticeDc"
                                            property="obligation"
                                            placeholder="Enter Document ID (DIN)" label="Obligation"
                                            visible="false" colspan="2">
                                <actions>
                                    <action id="customLookup" type="entity_lookup"/>
                                    <action id="entityClear" type="entity_clear"/>
                                </actions>
                            </entityComboBox>
                        </formLayout>

                        <formLayout id="fcnInfoForm" dataContainer="fundControlNoticeDc">
                            <datePicker id="fcnDateField" property="fcnDate" label="Date"/>
                            <textField id="amountField" property="amount" label="Amount"/>
                            <datePicker id="travelStartDateField" property="travelStartDate"
                                        label="Begin Travel Date" visible="false"/>
                            <datePicker id="travelEndDateField" property="travelEndDate" label="End Travel Date"
                                        visible="false"/>
                            <textArea id="memoField" property="memo" colspan="2"/>
                            <p id="aoSyncStringField" colspan="2"/>
                            <p text="Changing an FCN will not automatically update the obligation or projection"
                               classNames="text-error" colspan="2"/>
                        </formLayout>
                    </details>
                </vbox>
                <vbox classNames="contrast-panel">
                    <details opened="true" summaryText="Obligation" minWidth="100%">
                        <textField id="budgetFiscalYearField" label="Budget Fiscal Year"
                                   datatype="string" readOnly="true" colspan="2"/>
                        <formLayout id="obligationInfoForm" dataContainer="fundControlNoticeDc" visible="false">
                            <textField property="obligation.documentNumber" label="Document Number"
                                       readOnly="true"/>
                            <textField property="obligation.vendor" label="Vendor" readOnly="true"/>
                            <textField property="obligation.objectClass.titleAndCode"
                                       label="Object Class (BOC)"/>
                            <textField property="obligation.activity.division.titleAndCode"
                                       label="Division"/>
                            <textField property="obligation.documentType" label="Document Type"/>
                            <textField property="obligation.activity.fund" label="Fund"/>
                            <textField property="obligation.activity.titleAndCode" label="Activity"
                                       colspan="2"/>
                        </formLayout>
                    </details>
                </vbox>
            </div>
            <div classNames="grid-panel">
                <vbox classNames="contrast-panel">
                    <details opened="true" summaryText="Attachments" width="100%">
                        <fragment id="attachmentFragment"
                                  class="gov.fjc.fis.view.fileattachmentfragment.FileAttachmentFragment" colspan="2"/>
                    </details>
                </vbox>
            </div>
        </vbox>
        <vbox>
            <p id="createdByString"/>
        </vbox>
        <hbox id="detailActions"
              classNames="px-m py-s bg-contrast-5">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>