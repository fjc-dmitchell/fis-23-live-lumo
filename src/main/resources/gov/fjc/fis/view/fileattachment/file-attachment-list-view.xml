<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://fileAttachmentListView.title"
      focusComponent="fileAttachmentsDataGrid">
    <data>
        <collection id="fileAttachmentsDc"
                    class="gov.fjc.fis.entity.FileAttachment">
            <loader id="fileAttachmentsDl" readOnly="true"/>
        </collection>
