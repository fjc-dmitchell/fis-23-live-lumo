<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://activityProjectionDetailDialogView.title">
    <data>
        <instance id="activityProjectionDc"
                  class="gov.fjc.fis.entity.ActivityProjection">
            <fetchPlan extends="_base">
                <property name="createdByString"/>
            </fetchPlan>
            <loader id="activityProjectionDl"/>
        </instance>
        <collection id="objectClassesDc" class="gov.fjc.fis.entity.ObjectClass">
            <loader id="objectClassesDl" readOnly="true"/>
        </collection>
        <collection id="categoriesDc" class="gov.fjc.fis.entity.ObjectCategory">
            <loader id="categoriesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout alignItems="STRETCH"
            padding="false"
            expand="contentBox" width="750px" spacing="false">
        <vbox id="contentBox" css="overflow: auto" padding="false">
            <vbox id="formWrapper" classNames="contrast-panel">
                <formLayout id="form" dataContainer="activityProjectionDc" classNames="contrast-panel">
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="1" labelsPosition="ASIDE"/>
                    </responsiveSteps>
                    <formItem id="categoryFormItem" label="Category">
                        <entityComboBox id="categoryField" itemsContainer="categoriesDc"
                                        metaClass="fis_ObjectCategory"/>
                    </formItem>
                    <formItem>
                        <entityComboBox id="objectClassField" property="objectClass" itemsContainer="objectClassesDc"/>
                    </formItem>
                    <formItem>
                        <textField id="amountField" property="amount" datatype="decimal"/>
                    </formItem>
                </formLayout>
            </vbox>
        </vbox>
        <vbox>
            <p id="createdByString"/>
            <hbox id="detailActions" classNames="px-m py-s bg-contrast-5">
                <button id="saveAndCloseButton" action="saveAction"/>
                <button id="closeButton" action="closeAction"/>
            </hbox>
        </vbox>
    </layout>
</view>
