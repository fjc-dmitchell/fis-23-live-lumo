<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://activityProjectionListView.title"
      focusComponent="activityProjectionsDataGrid">
    <data>
        <collection id="activityProjectionsDc"
                    class="gov.fjc.fis.entity.ActivityProjection">
            <loader id="activityProjectionsDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <settings auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <fragment id="searchFragment" class="gov.fjc.fis.view.search.CustomSearchFragment">
            <properties>
                <property name="hostDataContainer" value="activityProjectionsDc" type="CONTAINER_REF"/>
            </properties>
        </fragment>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <!--            <button id="createBtn" action="activityProjectionsDataGrid.create"/>-->
            <button id="editBtn" action="activityProjectionsDataGrid.edit"/>
            <button id="excelExportBtn" action="activityProjectionsDataGrid.excelExport"/>
            <!--            <button id="removeBtn" action="activityProjectionsDataGrid.remove"/>-->
            <gridColumnVisibility dataGrid="activityProjectionsDataGrid" icon="COG"/>
            <simplePagination id="pagination" dataLoader="activityProjectionsDl" autoLoad="true"
                              itemsPerPageDefaultValue="250"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"/>
        </hbox>
        <!--        width="1450px"-->
        <dataGrid id="activityProjectionsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="activityProjectionsDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes" aggregatable="true">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="excelExport" type="grdexp_excelExport"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="activity.fund.fundCode" header="Fund" width="90px" flexGrow="0"/>
                <column property="activity.division.appropriation.budgetFiscalYear" header="BFY" width="70px"
                        flexGrow="0"/>
                <column property="activity.division.divisionCode" header="Division" textAlign="CENTER" width="90px"
                        flexGrow="0"/>
                <column property="activity.activityNumber" header="Activity" textAlign="CENTER" width="90px"
                        flexGrow="0"/>
                <column property="activity.title" header="Title" width="350px" flexGrow="1"/>
                <column property="activity.group.groupCode" header="Group" textAlign="CENTER" width="90px"
                        flexGrow="0"/>
                <column property="activity.branch.branchCode" header="Branch" textAlign="CENTER" width="90px"
                        flexGrow="0"/>
                <column property="objectClass.budgetObjectClass" header="BOC" textAlign="CENTER" width="75px"
                        flexGrow="0"/>
                <column property="amount" header="Projection" textAlign="END" width="120px" flexGrow="0">
                    <aggregation type="SUM" cellTitle="Total Two Year allocations">
                        <formatter>
                            <number format="#,##0.00"/>
                        </formatter>
                    </aggregation>
                </column>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>