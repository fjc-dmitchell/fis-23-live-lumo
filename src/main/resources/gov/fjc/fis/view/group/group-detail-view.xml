<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://groupDetailView.title"
      focusComponent="titleField">
    <data>
        <instance id="groupDc" class="gov.fjc.fis.entity.Group">
            <loader id="groupDl"/>
        </instance>
        <collection id="divisionsDc" class="gov.fjc.fis.entity.Division" fetchPlan="_base">
            <loader id="divisionsDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout expand="contentBox">
        <vbox id="contentBox" css="overflow: auto" padding="false">
            <vbox id="formWrapper" classNames="contrast-panel">
                <formLayout id="form" dataContainer="groupDc">
                    <vbox>
                        <hbox>
                            <textField id="budgetFiscalYearField" width="10em"
                                       label="Budget Fiscal Year" datatype="string" readOnly="true"/>
                            <entityComboBox id="divisionsComboBox" itemsContainer="divisionsDc" dataContainer="groupDc"
                                            property="division" label="Division" width="25em"/>
                        </hbox>
                        <hbox>
                            <textField id="groupCodeField" property="groupCode" width="10em" label="Group Code"
                                       dataContainer="groupDc"/>
                            <textField id="titleField" property="title" width="33em" label="Title"
                                       dataContainer="groupDc"/>
                            <textField id="sortCodeField" property="sortCode" width="6em" label="Sort Code"
                                       dataContainer="groupDc"/>
                        </hbox>
                    </vbox>
                </formLayout>
            </vbox>
            <vbox classNames="contrast-panel">
                <details id="activityDetails" opened="true" visible="false" summaryText="Activities"/>
            </vbox>
        </vbox>
        <p id="createdByString"/>
        <hbox id="detailActions">
            <button id="saveAndCloseBtn" action="saveAction"/>
            <button id="closeBtn" action="closeAction"/>
        </hbox>
    </layout>
</view>