<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://employeeListView.title"
      focusComponent="employeesDataGrid">
    <data>
        <collection id="employeesDc"
                    class="gov.fjc.fis.entity.personnel.Employee">
            <fetchPlan extends="_base"/>
            <loader id="employeesDl" readOnly="true">
                <query>
                    <![CDATA[select e from fis_Employee e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
        <action id="showDivisionAction"/>
    </actions>
    <layout>
        <details id="searchForm" opened="true" summaryText="Search and Filter" themeNames="filled">
        <tabSheet id="searchTabSheet">
            <tab id="divisionSearch" label="Quick Search">
                <vbox>
                    <hbox width="100%">
                        <button id="showAll" width="170px" text="Show All"/>
                        <hbox id="divisionSearchButtons">
                            <button id="showDiv1Btn" action="showDivisionAction" text="Show JXXXXXF (GA)"/>
                            <button id="showDiv2Btn" action="showDivisionAction" text="Show JXXXXXA (ED)"/>
                            <button id="showDiv3Btn" action="showDivisionAction" text="Show JXXXXXD (EIS)"/>
                            <button id="showDiv4Btn" action="showDivisionAction" text="Show JXXXXXC (RES)"/>
                            <button id="showDiv5Btn" action="showDivisionAction" text="Show JXXXXXB (ITO)"/>
                        </hbox>
                    </hbox>
                </vbox>
            </tab>
                            <tab id="customSearchTab" label="Custom Search">
                                <vbox id="searchvbox" width="100%" themeNames="spacing-xs" spacing="false" padding="false">
                                    <hbox>
                                    <propertyFilter id="nameSearch" property="name" operation="CONTAINS" dataLoader="employeesDl"
                                                    label="Name"/>
                                    <propertyFilter id="titleSearch" property="jobtitle" operation="CONTAINS" dataLoader="employeesDl"
                                                    label="Job Title"/>
                                    </hbox>
                                </vbox>
                            </tab>
        </tabSheet>
        </details>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <button id="createBtn" action="employeesDataGrid.create"/>
            <button id="editBtn" action="employeesDataGrid.edit"/>
            <button id="excelExportBtn" action="employeesDataGrid.excelExport"/>
            <button id="removeBtn" action="employeesDataGrid.remove"/>
            <simplePagination id="pagination" dataLoader="employeesDl" autoLoad="true"
                              itemsPerPageDefaultValue="250"
                              itemsPerPageVisible="true" itemsPerPageItems="250,500,1000"/>
        </hbox>
        <dataGrid id="employeesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="employeesDc"
                  columnReorderingAllowed="true" themeNames="column-borders compact row-stripes" selectionMode="NONE">
            <actions>
                <action id="create" type="list_create"/>
                <action id="edit" type="list_edit"/>
                <action id="excelExport" type="grdexp_excelExport"/>
                <action id="remove" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="loadedDate" visible="false"/>
                <column property="emplid" header="Employee ID"/>
                <column property="name" width="250px"/>
                <column property="jobcode" header="Job Code"/>
                <column property="positionNbr" header="Position" width="100px"/>
                <column property="jobtitle" header="Title" width="250px"/>
                <column property="emplType" header="Type" textAlign="CENTER"/>
                <column property="regTemp" header="Reg/Temp" textAlign="CENTER"/>
                <column property="fullPartTime" header="Full/Part" textAlign="CENTER"/>
                <column property="gvtWorkSched" header="Schedule" textAlign="CENTER"/>
                <column property="stdHours" header="Std Hours" textAlign="END"/>
                <column property="gvtApptExpirDt" textAlign="END" header="NTE"/>
                <column property="jlBudCatgCd" visible="false"/>
                <column property="jlCostOrgCd" header="Budget Org"/>
                <column property="deptId" header="Department"/>
                <column property="paygroup" header="Pay Group"/>
                <column property="grade"/>


                <column property="gvtComprate" width="100px" header="Basic" textAlign="END">
                    <numberRenderer numberFormat="#,##0"/>
                </column>
                <column property="gvtLocalityAdj" width="100px" header="Locality" textAlign="END">
                    <numberRenderer numberFormat="#,##0"/>
                </column>

                <column property="hourlyRt" header="Hourly" textAlign="END">
                    <numberRenderer numberFormat="#,##0.00"/>
                </column>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
