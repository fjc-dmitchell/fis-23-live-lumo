<!--            <property name="fund" fetchPlan="_base"/>-->
<!--        </property>-->
<!--    </fetchPlan>-->
    <fetchPlan entity="fis_Obligation" name="obligation-pivot-fetch-plan" extends="_base">
        <property name="activity" fetchPlan="_base"/>
        <property name="objectClass" fetchPlan="_base">
            <property name="objectCategory" fetchPlan="_base"/>
        </property>
        <property name="aoSyncString"/>
    </fetchPlan>
    <fetchPlan entity="fis_ActivityProjection" name="activityProjection-fetch-plan" extends="_base">
        <property name="activity" fetchPlan="_instance_name">
            <property name="fund" fetchPlan="_base"/>
        </property>
        <property name="objectClass" fetchPlan="_instance_name">
            <property name="objectCategory" fetchPlan="_base"/>
        </property>
    </fetchPlan>
    <fetchPlan entity="fis_Activity" name="division-obligations-report-fetch-plan" extends="_base">
        <property name="projections" fetchPlan="_base"/>
        <property name="obligations" fetchPlan="_base">
            <property name="invoices" fetchPlan="_base"/>
            <property name="objectClass" fetchPlan="_base">
                <property name="objectCategory" fetchPlan="_base"/>
            </property>
        </property>
    </fetchPlan>
    <fetchPlan entity="fis_Obligation" name="obligation-report-fetch-plan" extends="_base">
        <property name="activity" fetchPlan="_base">
            <property name="fund" fetchPlan="_base"/>
            <property name="branch" fetchPlan="_base"/>
            <property name="costOrg" fetchPlan="_base"/>
        </property>
    </fetchPlan>
